---
import '../styles/site.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Pyle · a small scripting language for C++',
	description = 'Pyle is a small, embeddable dynamic scripting language for C++17 with a familiar syntax, a bytecode VM, and a WASM-ready core.',
} = Astro.props;

const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;
const isPlayground = path.includes('/playground');
const github = 'https://github.com/Fus3n/pyle';
---

<!doctype html>
<html lang="en" data-theme="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#0f0f13" />
		<link rel="icon" type="image/svg+xml" href={`${base}pyle-logo.svg`} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<title>{title}</title>
		<script is:inline>
			(() => {
				const stored = localStorage.getItem('starlight-theme');
				const prefersLight = window.matchMedia('(prefers-color-scheme: light)').matches;
				const theme = !stored || stored === 'auto' ? (prefersLight ? 'light' : 'dark') : stored;
				document.documentElement.dataset.theme = theme === 'light' ? 'light' : 'dark';
			})();
		</script>
	</head>
	<body>
		<div class="site-shell">
			<header class="site-header">
				<div class="site-header__inner">
					<a class="site-brand" href={base} aria-label="Pyle home">
						<img class="site-brand__logo" src={`${base}pyle-logo.svg`} alt="" width="32" height="32" />
						<span>pyle</span>
					</a>
					<nav class="site-nav" aria-label="Main">
						<a href={`${base}getting-started/introduction/`}>Docs</a>
						<a
							class="site-nav__playground"
							href={`${base}playground/`}
							aria-current={isPlayground ? 'page' : undefined}>Playground</a
						>
						<a class="site-nav__github" href={github} target="_blank" rel="noopener noreferrer">
							<svg viewBox="0 0 16 16" aria-hidden="true" fill="currentColor"
								><path
									d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82A7.7 7.7 0 0 1 8 3.86c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
								></path></svg
							>
							<span class="sr-only">GitHub</span>
						</a>
						<button class="theme-toggle" type="button" data-theme-toggle aria-label="Toggle color scheme">
							<svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
								><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path></svg
							>
							<svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
								><circle cx="12" cy="12" r="4"></circle><path
									d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
								></path></svg
							>
						</button>
					</nav>
				</div>
			</header>

			<main class="site-main">
				<slot />
			</main>

			<footer class="site-footer">
				<div class="site-footer__inner">
					<span class="site-footer__brand"
						><img class="site-brand__logo" src={`${base}pyle-logo.svg`} alt="" width="24" height="24" />
						pyle</span
					>
					<div class="site-footer__links">
						<a href={`${base}getting-started/introduction/`}>Docs</a>
						<a href={`${base}playground/`}>Playground</a>
						<a href={github} target="_blank" rel="noopener noreferrer">GitHub</a>
						<a href={`${github}/blob/main/LICENSE`}>License</a>
					</div>
					<p class="site-footer__note">© 2026 Fus3n · MIT License</p>
				</div>
			</footer>
		</div>

		<script is:inline>
			document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
				const root = document.documentElement;
				const next = root.dataset.theme === 'light' ? 'dark' : 'light';
				root.dataset.theme = next;
				localStorage.setItem('starlight-theme', next);
				document
					.querySelector('meta[name="theme-color"]')
					?.setAttribute('content', next === 'light' ? '#fff8ee' : '#0f0f13');
			});
		</script>
	</body>
</html>
